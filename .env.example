# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model routing. Cheap tier carries the volume; hard tier only sees what the
# cheap tier reports low confidence on.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash

# Optional: Neatlogs tracing (hackathon partner). Unset = tracing is a no-op.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT=close-controller
