# Copy to .env and fill in. NEVER put a real value in this file — it is committed.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model routing. The cheap tier carries the volume; the strong tier only sees
# candidates the cheap tier reported low confidence on.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash

# Optional: Neatlogs tracing (hackathon partner). Unset = tracing is a no-op.
NEATLOGS_API_KEY=
NEATLOGS_INGEST_URL=
NEATLOGS_PROJECT=close-controller
